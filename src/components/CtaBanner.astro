---
interface Props {
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  bgImage?: string;
}

const {
  heading,
  body,
  ctaLabel,
  ctaHref,
  bgImage = 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=1800&q=80',
} = Astro.props;
---

<section class="relative overflow-hidden px-12 py-22">
  <img
    src={bgImage}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-[rgba(13,22,2,0.72)]"></div>
  <div
    class="relative mx-auto max-w-180 rounded-3xl border border-white/25 bg-white/12 px-12 py-14 text-center backdrop-blur-xl"
  >
    <h2 class="mt-0 mb-4 font-serif text-[30px] text-cream!">{heading}</h2>
    <p class="mt-0 mb-7 leading-relaxed text-mist">{body}</p>
    <a
      href={ctaHref}
      class="inline-block rounded-full bg-cream px-8 py-4 text-sm font-bold text-brand-dark! no-underline"
    >
      {ctaLabel}
    </a>
  </div>
</section>
