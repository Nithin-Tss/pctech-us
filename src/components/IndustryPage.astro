---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FeatureIcon from './icons/FeatureIcon.astro';

interface Feature {
  title: string;
  desc: string;
  icon?: string;
}

interface Props {
  title: string;
  tagline: string;
  intro: string;
  heroImage?: string;
  features: Feature[];
}

const {
  title,
  tagline,
  intro,
  heroImage = 'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=1400&q=80',
  features,
} = Astro.props;

const allIndustryDefs = [
  { name: 'Manufacturing', href: '/manufacturing' },
  { name: 'Automotive', href: '/automotive' },
  { name: 'Healthcare', href: '/healthcare' },
];

const allIndustries = allIndustryDefs.map((s) => ({
  ...s,
  active: s.name === title,
}));
---

<BaseLayout title={title} description={tagline}>
  <div class="bg-cream font-sans text-ink">
    <Header />

    <!-- INDUSTRY HERO -->
    <section class="relative overflow-hidden px-12 py-18">
      <div
        class="absolute inset-0"
        style="background: repeating-linear-gradient(135deg, #2B4D01, #2B4D01 22px, #24400a 22px, #24400a 44px);"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-black/55 via-black/30 to-transparent"
      >
      </div>
      <div class="relative mx-auto max-w-300">
        <div class="mb-3.5 text-[13px] text-sage">
          <a href="/" class="text-sage! no-underline">Home</a> / <a
            href="#"
            class="text-sage! no-underline">Industries</a
          > / <span class="text-cream">{title}</span>
        </div>
        <div
          class="max-w-160 rounded-[22px] border border-white/28 bg-white/14 px-11 py-10 backdrop-blur-2xl"
        >
          <div
            class="mb-3 text-xs font-bold tracking-widest text-sage uppercase"
          >
            Industry
          </div>
          <h1 class="mt-0 mb-4 font-serif text-[38px] leading-tight text-cream">
            {title}
          </h1>
          <p class="m-0 leading-relaxed text-mist">{tagline}</p>
        </div>
      </div>
    </section>

    <!-- CONTENT -->
    <section
      class="mx-auto grid max-w-300 grid-cols-[1.6fr_0.9fr] items-start gap-14 px-12 py-20"
    >
      <div>
        <div class="mb-10 aspect-16/8 overflow-hidden rounded-[20px]">
          <img
            src={heroImage}
            alt={title}
            class="block h-full w-full object-cover"
          />
        </div>

        <h2 class="mt-0 mb-4 font-serif text-[26px] text-brand-dark">
          Overview
        </h2>
        <p class="mt-0 mb-10 leading-loose text-ink-muted">{intro}</p>

        <h2 class="mt-0 mb-6 font-serif text-[22px] text-brand-dark">
          How we help
        </h2>
        <div class="mb-4 grid grid-cols-2 gap-5">
          {
            features.map((f: Feature) => (
              <div class="rounded-2xl border border-white/70 bg-white/55 p-6 backdrop-blur-xl">
                <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-[#E4EBD6] text-brand">
                  <FeatureIcon name={f.icon ?? 'layers'} />
                </div>
                <h3 class="mt-0 mb-2 font-serif text-[17px] text-brand-dark">
                  {f.title}
                </h3>
                <p class="m-0 leading-relaxed text-ink-muted">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="sticky top-6 flex flex-col gap-6">
        <div
          class="rounded-[20px] border border-white/70 bg-white/55 p-7 shadow-[0_8px_28px_rgba(43,77,1,0.08)] backdrop-blur-xl"
        >
          <h3 class="mt-0 mb-4.5 font-serif text-[17px] text-brand-dark">
            Our Industries
          </h3>
          <div class="flex flex-col gap-1">
            {
              allIndustries.map((s) => (
                <a
                  href={s.href}
                  class={`rounded-[10px] px-3.5 py-3 text-sm font-semibold no-underline ${s.active ? 'text-brand!' : 'text-ink!'}`}
                >
                  {s.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- HAVE A PROJECT IN MIND -->
    <section class="mx-auto max-w-300 px-12 pb-25">
      <div class="rounded-[28px] bg-brand-dark px-10 py-16 text-center">
        <div
          class="mb-2.5 text-[13px] font-bold tracking-widest text-sage uppercase"
        >
          Let's Talk
        </div>
        <h2 class="mt-0 mb-4 font-serif text-[32px] text-cream!">
          Have a project in mind?
        </h2>
        <p class="mx-auto mt-0 mb-7 max-w-120 leading-relaxed text-sage">
          Tell us about your {title} needs — we'll tell you how we'd approach it,
          no obligation.
        </p>
        <a
          href="/contact-us"
          class="inline-block rounded-full bg-cream px-8 py-4 text-sm font-bold text-brand-dark! no-underline"
        >
          Contact Us
        </a>
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>
