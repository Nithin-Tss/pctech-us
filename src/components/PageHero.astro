---
interface Props {
  eyebrow: string;
  title: string;
  tagline: string;
  breadcrumbLabel: string;
  heroImage?: string;
}

const {
  eyebrow,
  title,
  tagline,
  breadcrumbLabel,
  heroImage = 'https://images.unsplash.com/photo-1455849318743-b2233052fcff?q=80&w=2338&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
} = Astro.props;
---

<section
  class="relative overflow-hidden px-4 py-12 sm:px-6 sm:py-16 lg:px-12 lg:py-18"
>
  <div class="absolute inset-0">
    <img
      src={heroImage}
      alt="P & C Technology Consulting team"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>
  <div
    class="absolute inset-0 bg-linear-to-r from-black/55 via-black/30 to-transparent"
  >
  </div>
  <div class="relative mx-auto max-w-300">
    <div class="mb-3.5 text-[13px] text-sage">
      <a href="/" class="text-sage! no-underline">Home</a> / <span
        class="text-cream">{breadcrumbLabel}</span
      >
    </div>
    <div
      class="max-w-160 rounded-[22px] border border-white/28 bg-white/14 px-6 py-7 backdrop-blur-2xl sm:px-11 sm:py-10"
    >
      <div class="mb-3 text-xs font-bold tracking-widest text-sage uppercase">
        {eyebrow}
      </div>
      <h1
        class="mt-0 mb-4 font-serif text-[28px] leading-tight text-cream sm:text-[38px]"
      >
        {title}
      </h1>
      <p class="m-0 leading-relaxed text-mist">{tagline}</p>
    </div>
  </div>
</section>
