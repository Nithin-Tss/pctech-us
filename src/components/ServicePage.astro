---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FeatureIcon from './icons/FeatureIcon.astro';

interface Feature {
  title: string;
  desc: string;
  icon?: string;
}

interface Props {
  title: string;
  tagline: string;
  intro: string;
  heroImage?: string;
  overviewImage?: string;
  secondaryImage?: string;
  features: Feature[];
}

const {
  title,
  tagline,
  intro,
  heroImage = 'https://images.unsplash.com/photo-1593720213428-28a5b9e94613?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
  overviewImage = 'https://images.unsplash.com/photo-1629904853716-f0bc54eea481?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
  secondaryImage = 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1400&q=80',
  features,
} = Astro.props;
---

<BaseLayout title={title} description={tagline}>
  <div class="bg-cream font-sans text-ink">
    <Header />

    <!-- SERVICE HERO -->
    <section
      class="relative overflow-hidden px-4 py-12 sm:px-6 sm:py-16 lg:px-12 lg:py-18"
    >
      <div class="absolute inset-0">
        <img
          src={heroImage}
          alt=""
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-black/55 via-black/30 to-transparent"
      >
      </div>
      <div class="relative mx-auto max-w-300">
        <div class="mb-3.5 text-[13px] text-sage">
          <a href="/" class="text-sage! no-underline">Home</a> / <a
            href="#"
            class="text-sage! no-underline">Services</a
          > / <span class="text-cream">{title}</span>
        </div>
        <div
          class="max-w-160 rounded-[22px] border border-white/28 bg-white/14 px-6 py-7 backdrop-blur-2xl sm:px-11 sm:py-10"
        >
          <div
            class="mb-3 text-xs font-bold tracking-widest text-sage uppercase"
          >
            Service
          </div>
          <h1
            class="mt-0 mb-4 font-serif text-[28px] leading-tight text-cream sm:text-[38px]"
          >
            {title}
          </h1>
          <p class="m-0 leading-relaxed text-mist">{tagline}</p>
        </div>
      </div>
    </section>

    <!-- CONTENT -->
    <section
      class="mx-auto max-w-300 px-4 py-14 sm:px-6 sm:py-16 lg:px-12 lg:py-20"
    >
      <div
        class="mb-16 flex flex-col gap-10 lg:mb-28 lg:flex-row lg:items-stretch lg:gap-16"
      >
        <div class="flex flex-1 flex-col justify-center">
          <div class="mb-3 flex items-center gap-2.5">
            <span class="h-px w-8 bg-brand"></span>
            <span
              class="text-sm font-bold tracking-widest text-brand uppercase"
            >
              Overview
            </span>
          </div>
          <h2
            class="mt-0 mb-4 font-serif text-[24px] text-brand-dark sm:text-[32px]"
          >
            What {title} means for your business
          </h2>
          <p class="m-0 text-base leading-loose text-ink-muted sm:text-lg">
            {intro}
          </p>
        </div>
        <div class="relative flex-1">
          <div
            class="absolute -inset-4 -z-10 rounded-4xl bg-linear-to-br from-brand/20 to-sage-dark/30 blur-2xl"
          >
          </div>
          <div
            class="h-full min-h-56 overflow-hidden rounded-[22px] ring-1 ring-black/5 sm:min-h-72"
          >
            <img
              src={overviewImage}
              alt={title}
              class="block h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-10 lg:flex-row lg:items-stretch lg:gap-16">
        <div class="relative flex-[1.35]">
          <div
            class="absolute -inset-4 -z-10 rounded-4xl bg-linear-to-br from-sage-dark/25 to-brand/20 blur-2xl"
          >
          </div>
          <div
            class="h-full min-h-56 overflow-hidden rounded-[22px] ring-1 ring-black/5 sm:min-h-88"
          >
            <img
              src={secondaryImage}
              alt=""
              class="block h-full w-full object-cover"
            />
          </div>
        </div>
        <div class="flex flex-[0.9] flex-col justify-center">
          <div class="mb-3 flex items-center gap-2.5">
            <span class="h-px w-8 bg-brand"></span>
            <span
              id="deliver"
              class="text-sm font-bold tracking-widest text-brand uppercase"
            >
              Capabilities
            </span>
          </div>
          <h2
            class="mt-0 mb-6 font-serif text-[22px] text-brand-dark sm:text-[26px]"
          >
            What we deliver
          </h2>
          <div class="flex flex-col gap-6">
            {
              features.map((f: Feature) => (
                <div class="flex gap-4">
                  <FeatureIcon
                    name={f.icon ?? 'badge'}
                    class="mt-1 h-6 w-6 shrink-0 text-brand"
                  />
                  <div>
                    <h3 class="mt-0 mb-2 font-serif text-[18px] text-brand-dark sm:text-[20px]">
                      {f.title}
                    </h3>
                    <p class="m-0 text-base leading-loose text-ink-muted sm:text-lg">
                      {f.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- HAVE A PROJECT IN MIND -->
    <section
      class="mx-auto max-w-300 px-4 pb-16 sm:px-6 sm:pb-20 lg:px-12 lg:pb-25"
    >
      <div
        class="relative overflow-hidden rounded-4xl bg-brand-dark px-6 py-10 text-center sm:px-10 sm:py-16"
      >
        <div
          class="absolute -top-16 left-1/3 h-72 w-72 animate-float-slow rounded-full bg-sage/20 blur-3xl"
        >
        </div>
        <div
          class="absolute -right-10 -bottom-20 h-64 w-64 rounded-full bg-brand/40 blur-3xl"
        >
        </div>

        <div class="relative">
          <div
            class="mb-2.5 text-[13px] font-bold tracking-widest text-sage uppercase"
          >
            Let's Talk
          </div>
          <h2
            class="mt-0 mb-4 font-serif text-[24px] text-cream! sm:text-[32px]"
          >
            Have a project in mind?
          </h2>
          <p class="mx-auto mt-0 mb-7 max-w-120 leading-relaxed text-sage">
            Tell us about your {title} needs — we'll tell you how we'd approach it,
            no obligation.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a
              href="/contact-us"
              class="inline-block rounded-full bg-cream px-8 py-4 text-sm font-bold text-brand-dark! no-underline transition-transform hover:scale-[1.03]"
            >
              Contact Us
            </a>
            <a
              href="mailto:info@pctech-net.com"
              class="inline-flex items-center gap-2 rounded-full border border-white/25 px-8 py-4 text-sm font-bold text-cream! no-underline transition-colors hover:bg-white/10"
            >
              info@pctech-net.com
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>
