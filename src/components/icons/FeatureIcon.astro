---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'cloud-migration' && (
      <>
        <path d="M7 17.5h9.5a3.5 3.5 0 100-7 5 5 0 00-9.6-1.5A3.5 3.5 0 006 17.5" />
        <path d="M12 20v-6" />
        <path d="M9.2 16.2L12 13.4l2.8 2.8" />
      </>
    )
  }

  {
    name === 'layers' && (
      <>
        <path d="M12 3.5l8 4-8 4-8-4 8-4z" />
        <path d="M4 12.5l8 4 8-4" />
        <path d="M4 16.5l8 4 8-4" />
      </>
    )
  }

  {
    name === 'gauge' && (
      <>
        <circle cx="12" cy="13" r="7.2" />
        <path d="M12 13l3.4-3.4" />
