  {
    name === 'user-check' && (
      <>
        <circle cx="9" cy="8" r="3.4" />
        <path d="M3.3 20c0-3.4 2.6-5.8 5.7-5.8s5.7 2.4 5.7 5.8" />
        <path d="M15.5 13.2l1.9 1.9 3.8-3.8" />
      </>
