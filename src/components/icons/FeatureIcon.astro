    name === 'pipeline' && (
      <>
        <rect x="3" y="10" width="18" height="4.5" rx="2.25" />
        <circle cx="7.5" cy="12.25" r="0.9" />
        <circle cx="12" cy="12.25" r="0.9" />
        <circle cx="16.5" cy="12.25" r="0.9" />
      </>
    )
  }

  {
    name === 'bar-chart' && (
      <>
        <path d="M3 20h18" />
        <path d="M6 20v-6M12 20V8M18 20v-10" />
