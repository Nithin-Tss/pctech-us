  }

  {
    name === 'arrows-meet' && (
      <>
        <path d="M3 12h6.5" />
        <path d="M6.7 9l2.8 3-2.8 3" />
        <path d="M21 12h-6.5" />
        <path d="M17.3 15l-2.8-3 2.8-3" />
