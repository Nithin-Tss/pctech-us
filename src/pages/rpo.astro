---
import ServicePage from '../components/ServicePage.astro';

const features = [
  {
    title: 'Dedicated Recruiters',
    desc: 'Embed experienced recruiters into your hiring process to source, screen, and shortlist candidates who align with your business goals and culture.',
    icon: 'user-search',
  },
  {
    title: 'Scalable Volume',
    desc: 'Scale your recruitment efforts up or down as hiring needs evolve. Our flexible RPO solutions help you meet changing workforce demands efficiently.',
    icon: 'resize',
  },
  {
    title: 'Employer Branding',
    desc: 'Strengthen your employer brand and create a positive candidate experience throughout the recruitment journey, from initial engagement to onboarding.',
    icon: 'badge',
  },
  {
    title: 'Reporting & Analytics',
    desc: 'Gain complete visibility into your hiring pipeline with data-driven insights, recruitment forecasting, and regular performance reporting.',
    icon: 'bar-chart',
  },
];
---

<ServicePage
  title="RPO"
  tagline="Our RPO solutions combine industry expertise and proven recruitment strategies to help businesses hire smarter, faster, and more efficiently."
  intro="Our Recruitment Process Outsourcing (RPO) model seamlessly integrates with your team, providing dedicated sourcing and screening expertise that scales with your hiring needs. By acting as an extension of your organization, we deliver the flexibility to adapt to changing recruitment demands while eliminating the costs and complexities of building and managing an in-house talent acquisition team."
  heroImage="https://images.unsplash.com/photo-1758518730384-be3d205838e8?q=80&w=3131&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
  overviewImage="https://images.unsplash.com/photo-1622675205169-901710ac8643?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
  secondaryImage="https://images.unsplash.com/photo-1762330463265-07c5ac9b98cd?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
