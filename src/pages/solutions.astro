---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';

const cases = [
  {
    name: 'Fleet Management Modernization',
    industry: 'Automotive',
    img: 'https://images.unsplash.com/photo-1487754180451-c456f719a1fc?w=800&q=80',
    blurb:
      'Modernized and transformed a legacy fleet-tracking system by migrating it to a scalable cloud-based architecture, reducing downtime by 40% and improving overall system reliability and performance.',
  },
  {
    name: 'Patient Intake Platform',
    industry: 'Healthcare',
    img: 'https://images.unsplash.com/photo-1550831107-1553da8c8464?w=800&q=80',
    blurb:
      'Designed and implemented a HIPAA-compliant patient intake system that streamlined clinical workflows and was successfully adopted across 12 healthcare facilities.',
  },
  {
    name: 'Plant Floor Analytics',
    industry: 'Manufacturing',
    img: 'https://images.unsplash.com/photo-1589793463357-5fb813435467?q=80&w=988&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    blurb:
      'Developed and deployed real-time dashboards that provided plant managers with actionable insights into production line performance, enabling faster decision-making and improved operational efficiency.',
  },
  {
    name: 'Citizen Services Portal',
    industry: 'Government',
    img: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=800&q=80',
    blurb:
      'Modernized and transformed a public-facing services portal, reducing processing times by 50% while enhancing user experience, accessibility, and operational efficiency.',
  },
];
---

<BaseLayout
  title="Solutions"
  description="A sample of the work we've done for clients across manufacturing, healthcare, automotive, and government."
>
  <div class="bg-cream font-sans text-ink">
    <Header />

    <PageHero
      eyebrow="Our Portfolio"
      title="Solutions we've delivered"
      tagline="A sample of the work we've done for clients across manufacturing, healthcare, automotive, and government."
      breadcrumbLabel="Solutions"
    />

    <!-- CASE STUDIES -->
    <section
      class="mx-auto max-w-300 px-4 py-16 sm:px-6 sm:py-20 lg:px-12 lg:py-25"
    >
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {
          cases.map((c) => (
            <div class="overflow-hidden rounded-[20px] bg-[#F1ECDD]">
              <div class="aspect-16/10 overflow-hidden">
                <img
                  src={c.img}
                  alt={c.name}
                  class="block h-full w-full object-cover"
                />
              </div>
              <div class="p-8">
                <div class="mb-2.5 text-xs font-bold tracking-wide text-brand uppercase">
                  {c.industry}
                </div>
                <h3 class="mt-0 mb-2.5 font-serif text-[21px] text-brand-dark">
                  {c.name}
                </h3>
                <p class="m-0 leading-relaxed text-ink-muted">{c.blurb}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <CtaBanner
      heading="Have a project in mind?"
      body="Tell us what you're trying to solve — we'll tell you how we'd approach it."
      ctaLabel="Contact Us"
      ctaHref="/contact-us"
    />

    <Footer />
  </div>
</BaseLayout>
